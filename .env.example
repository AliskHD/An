# Microsoft Graph (Teams lesen)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-app-client-secret
TEAMS_TEAM_ID=team-id-der-mont-blanc-abteilung
TEAMS_CHANNEL_ID=channel-id-fuer-daily-reports
TEAMS_CHAT_ID=chat-id-fuer-tagesplan-post

# Power Automate Flow (Teams schreiben + Excel anhaengen)
# Flow "HTTP Request empfangen" -> Excel in OneDrive ablegen -> Teams-Nachricht posten
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.westeurope.logic.azure.com/workflows/...

# Claude API (Rueckfragen bei unklaren Meldungen)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Daten-Verzeichnis
DATA_DIR=./data
OUTPUT_DIR=./output
